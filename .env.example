# Copy to .env only if working on local tooling or the excluded second-gen layer.
# Never commit .env files or real API keys.
#
# The shipped Chrome/Edge MV3 extension requires ZERO environment variables:
# the optional Google Gemini API key is Bring-Your-Own-Key (BYOK), entered by
# the user in the popup Settings panel and stored locally in chrome.storage.local.

# Referenced in src/common/errors/ErrorHandler.ts (set automatically by webpack/jest)
NODE_ENV=production

# Base URL read by src/config/AppConfig.ts (excluded second-gen layer; not wired into the shipped extension build)
API_BASE_URL=

{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "*": [
                "src/*"
            ],
            "@common/*": [
                "src/common/*"
            ],
            "@content/*": [
                "src/content/*"
            ],
            "@background/*": [
                "src/background/*"
            ],
            "@popup/*": [
                "src/popup/*"
            ]
        },
        "types": [
            "chrome",
            "jest",
            "node"
        ],
        "resolveJsonModule": true,
        "isolatedModules": true
    },
    "include": [
        "src/**/*",
        "tests/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "development",
        "src/service-worker.ts",
        "src/services",
        "src/core",
        "src/popup/components/EnhancedApp.tsx",
        "src/popup/components/enhanced",
        "src/popup/components/protect/EnhancedProtectSection.tsx",
        "src/popup/components/insight/EnhancedInsightSection.tsx",
        "src/popup/components/scout/EnhancedScoutSection.tsx",
        "src/background/services/cache",
        "src/background/services/integration",
        "src/background/services/models",
        "src/background/services/monitoring",
        "src/background/services/protect/aiDetector.ts",
        "src/background/services/protect/smartRiskAssessment.ts",
        "src/common/utils/MemoryManager.ts",
        "src/config/AppConfig.ts",
        "tests/setup/mocks/types.ts"
    ]
}
